{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PomoLiveMessageEnvelope",
  "type": "object",
  "required": ["event", "session_id", "timestamp", "payload"],
  "properties": {
    "event": {
      "type": "string",
      "description": "Nome da acao em UPPERCASE"
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador UUID da sessao ativa"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO 8601 UTC"
    },
    "payload": {
      "type": "object",
      "description": "Objeto com dados especificos de cada evento"
    }
  }
}